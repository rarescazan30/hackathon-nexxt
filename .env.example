# Copy to .env.local and fill in. Never commit .env.local.

# AI (free tiers)
AI_PROVIDER=mock                 # gemini | groq | mock
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_
SUPABASE_SECRET_KEY=sb_secret_   # server only

# Test user Andrei created by `npm run seed` (log in with the normal form)
DEMO_USER_EMAIL=andrei@zile.test
DEMO_USER_PASSWORD=

# Admin account created by `npm run seed`; it sees the Admin button and /admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Stripe (test mode only)
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Cron
CRON_SECRET=
